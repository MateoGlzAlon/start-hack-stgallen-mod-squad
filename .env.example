# Copy to .env (`make env` does this). Never commit .env.
# No quotes and no spaces around the equals sign (the Makefile includes this file).

# Handed out on the event day. Empty = the Viseca worker stays off.
TEAM_API_KEY=
VISECA_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io

# OpenAI: needed to create policies; optional for purchase decisions (they fall back to the policy's uncertainty_policy).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# make provision_local: the model served by the llm container (llama.cpp) instead of the OpenAI API (Claude models cannot run locally).
# Swiss AI's Apertus 8B Instruct, downloaded from Hugging Face on the first start (about 5 GB, needs internet). Format: <user>/<repo>[:quant]
# Any other GGUF works too (bigger = better answers, more memory, slower).
LOCAL_MODEL=unsloth/Apertus-8B-Instruct-2509-GGUF:Q4_K_M

# Exchange rates: read once at startup from Viseca (needs TEAM_API_KEY), else this JSON file, else the data pack's fx_rates.csv.
# Empty = the mock file inside the jar (backend/src/main/resources/mock/exchange-rates.json).
# FX_RATES_FILE=

# Host ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
